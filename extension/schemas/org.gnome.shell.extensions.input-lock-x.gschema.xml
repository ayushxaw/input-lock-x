<schemalist>
  <schema id="org.gnome.shell.extensions.input-lock-x"
          path="/org/gnome/shell/extensions/input-lock-x/">

    <!-- Key name kept from the pre-rename schema on purpose: install.sh
         migrates the old binding across by dconf path, and a key rename would
         add a second thing that can go wrong for no user-visible gain. -->
    <key name="toggle-hid" type="as">
      <default><![CDATA[['<Control>Escape']]]></default>
      <summary>Engage the keyboard and touchpad lock</summary>
      <description>
        Shortcut that engages the lock from GNOME. On an already locked
        keyboard, the daemon uses Ctrl+Esc to open the PIN prompt and
        Ctrl+A+Esc to release input in an emergency.
      </description>
    </key>

  </schema>
</schemalist>
